{
  "name": "agentcore-studio-web",
  "private": true,
  "version": "0.1.0",
  "description": "AgentCore Studio — Vite + React Flow scaffold (empty canvas, Decision #11). Mentor owns; SWE grows the canvas UX in later sprints. NOT a Python uv workspace member — see root pyproject.toml [tool.uv.workspace].exclude.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "emit-fixture": "node scripts/run.mjs scripts/emit-fixture.ts > ../../packages/workbench/tests/fixtures/canvas_export_d12.json",
    "check-parity": "node scripts/run.mjs scripts/check-lint-parity.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "tldts": "7.4.10",
      "tldts-core": "7.4.10"
    }
  }
}
